# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AIzaSyA_6odIUkjJKxW19g_JT32jcyXzy-YP930"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# PORT: The port that the local server binds to (default: 3000, user configuration: 3001)
PORT=3001

# MONGODB_URI: Connection string for MongoDB (Local instance or Mongo Atlas Cluster)
# Local instance URI example:
MONGODB_URI="mongodb://localhost:27017/chatbot"
# MongoDB Atlas Cloud URI example:
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/chatbot?retryWrites=true&w=majority"

# NODE_ENV: Set to "development" for Vite HMR previewing or "production" to run the optimized compiled asset bundle
NODE_ENV="development"
